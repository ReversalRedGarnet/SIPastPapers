# Copy to .env.local (gitignored) and fill in real values as needed.
# Next.js loads .env.local automatically; scripts/cli.ts loads it too.

# Canonical production origin, used for sitemap.xml, robots.txt's Sitemap:
# line, and JSON-LD urls (see src/lib/site.ts). Optional -- defaults to the
# current production domain if unset.
NEXT_PUBLIC_SITE_URL=https://www.sipastexams.com

# Which storage backend serves/stores exam PDFs — see src/lib/storage/index.ts.
#   local (default) - writes under ./local-storage, no config needed.
#   r2              - Cloudflare R2 (S3-compatible); requires all four
#                      R2_* variables below.
STORAGE_BACKEND=local

# Required only when STORAGE_BACKEND=r2.
# Endpoint is derived from R2_ACCOUNT_ID: https://<account-id>.r2.cloudflarestorage.com
# Create the access key pair under Cloudflare dashboard -> R2 -> Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Postgres (Neon) — required, no local/offline fallback. Get both from the
# Neon dashboard -> your project -> Connect.
#   DATABASE_URL        - the DIRECT (unpooled) connection string. Used
#                          only by `npm run db:migrate` (see
#                          migrations/README.md).
#   DATABASE_URL_POOLED - the POOLED connection string (via Neon's
#                          PgBouncer-based pooler, usually the host with
#                          "-pooler" in it). Used by the app/CLI at
#                          runtime — see src/lib/db/client.ts.
DATABASE_URL=
DATABASE_URL_POOLED=

# Download rate limiting — see src/lib/rate-limit.ts.
# RATE_LIMIT_SECRET signs the anonymous visitor cookie. Set it in production
# (any long random string, e.g. `openssl rand -hex 32`); without it each
# running copy of the app makes up its own, and cookies stop matching
# between copies.
RATE_LIMIT_SECRET=
# Optional overrides (defaults shown). Each counts DISTINCT items in a
# sliding window: per visitor cookie, per IP address (backstop shared by
# everyone at that address), and per IP for requests with no valid cookie.
# PREVIEW = the PDF box on a paper's page; OPEN = opening a paper (Open PDF,
# Open in new tab, results list); ZIP = a whole year's papers; REPORT = the
# report-a-problem form.
# RATE_LIMIT_WINDOW_SECONDS=600
# RATE_LIMIT_PREVIEW_PER_VISITOR=120   RATE_LIMIT_PREVIEW_PER_IP=1000  RATE_LIMIT_PREVIEW_PER_IP_NO_COOKIE=300
# RATE_LIMIT_OPEN_PER_VISITOR=40       RATE_LIMIT_OPEN_PER_IP=600      RATE_LIMIT_OPEN_PER_IP_NO_COOKIE=60
# RATE_LIMIT_ZIP_PER_VISITOR=3         RATE_LIMIT_ZIP_PER_IP=20        RATE_LIMIT_ZIP_PER_IP_NO_COOKIE=10
# RATE_LIMIT_REPORT_PER_VISITOR=5      RATE_LIMIT_REPORT_PER_IP=30     RATE_LIMIT_REPORT_PER_IP_NO_COOKIE=10
# How often src/proxy.ts reloads the list of real browse/paper addresses, in
# seconds (default 300). A newly published paper 404s for up to this long.
# PAGE_PATHS_REFRESH_SECONDS=300
