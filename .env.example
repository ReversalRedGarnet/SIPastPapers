# Copy to .env.local (gitignored) and fill in real values as needed.
# Next.js loads .env.local automatically; scripts/cli.ts loads it too.

# Canonical production origin, used for sitemap.xml, robots.txt's Sitemap:
# line, and JSON-LD urls (see src/lib/site.ts). Optional -- defaults to the
# current Vercel deployment if unset. Set this if/when a custom domain is
# attached.
NEXT_PUBLIC_SITE_URL=https://si-past-papers.vercel.app

# Which storage backend serves/stores exam PDFs — see src/lib/storage/index.ts.
#   local (default) - writes under ./local-storage, no config needed.
#   r2              - Cloudflare R2 (S3-compatible); requires all four
#                      R2_* variables below.
STORAGE_BACKEND=local

# Required only when STORAGE_BACKEND=r2.
# Endpoint is derived from R2_ACCOUNT_ID: https://<account-id>.r2.cloudflarestorage.com
# Create the access key pair under Cloudflare dashboard -> R2 -> Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Postgres (Neon) — required, no local/offline fallback. Get both from the
# Neon dashboard -> your project -> Connect.
#   DATABASE_URL        - the DIRECT (unpooled) connection string. Used
#                          only by `npm run db:migrate` (see
#                          migrations/README.md).
#   DATABASE_URL_POOLED - the POOLED connection string (via Neon's
#                          PgBouncer-based pooler, usually the host with
#                          "-pooler" in it). Used by the app/CLI at
#                          runtime — see src/lib/db/client.ts.
DATABASE_URL=
DATABASE_URL_POOLED=
